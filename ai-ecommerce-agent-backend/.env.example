# PostgreSQL Database Connection URL (Template)
# Replace YOUR_PASSWORD with your actual local PostgreSQL password in your private .env file
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/raya_ecommerce

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama AI Agent Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
